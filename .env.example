# Copy this file to .env and fill in real values. Never commit .env itself.

# Core paths (optional; relative to the project root)
WORKSPACE_DIR=workspace
PUBLISHED_DIR=published
FAILED_DIR=failed
LOGS_DIR=logs
LOG_LEVEL=INFO

# PeerTube
PEERTUBE_INSTANCE_URL=
PEERTUBE_USERNAME=
PEERTUBE_PASSWORD=
PEERTUBE_CHANNEL_ID=
# 1=Public, 2=Unlisted, 3=Private, 4=Internal
PEERTUBE_PRIVACY=1

# Internet Archive IAS3
IA_ACCESS_KEY=
IA_SECRET_KEY=
IA_COLLECTION=
IA_MEDIATYPE=movies
