# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Core paths (optional -- sensible defaults are used if omitted) ---
WORKSPACE_DIR=workspace
PUBLISHED_DIR=published
FAILED_DIR=failed
LOGS_DIR=logs
LOG_LEVEL=INFO

# --- PeerTube credentials (read directly by publishers/peertube.py) ---
PEERTUBE_INSTANCE_URL=
PEERTUBE_USERNAME=
PEERTUBE_PASSWORD=
PEERTUBE_CHANNEL_ID=
# 1=Public, 2=Unlisted, 3=Private, 4=Internal
PEERTUBE_PRIVACY=1
